# ==============================================================================
# Tiv AI Data Collection Platform — Environment Configuration Template
# Copy this file to .env and adjust values for local development.
# NEVER commit real credentials or secrets to version control.
# ==============================================================================

# Server & Runtime Configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Configuration (Allow Developer 2 frontend Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Relational Database (Developer 1)
# Local development default: PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tiv_ai
# SQLite alternative for lightweight testing:
# DATABASE_URL=sqlite:///./tiv_ai_dev.db

# Storage Abstraction Configuration (Developer 3)
# Options: 'local' (filesystem) or 's3' (object storage)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=.storage

# Cloud Object Storage (Only required when STORAGE_BACKEND=s3)
S3_BUCKET_NAME=tiv-ai-data-private
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGNED_EXPIRATION_SECONDS=900

# Audio Ingestion & Validation Guardrails (Developer 3)
MAX_AUDIO_SIZE_BYTES=26214400
MIN_AUDIO_DURATION_SECONDS=0.5
MAX_AUDIO_DURATION_SECONDS=120.0
CONSENT_VERSION=v1.0-2026-09
